{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "启动后端 (Spring Boot)",
            "type": "shell",
            "command": "mvn",
            "args": ["spring-boot:run"],
            "options": {
                "cwd": "${workspaceFolder}/back"
            },
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": false,
                "clear": false
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "启动前端 (Vue Dev)",
            "type": "shell",
            "command": "npm",
            "args": ["run", "dev"],
            "options": {
                "cwd": "${workspaceFolder}/front"
            },
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new",
                "showReuseMessage": false,
                "clear": false
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "启动开发环境 (后端+前端)",
            "dependsOn": [
                "启动后端 (Spring Boot)",
                "启动前端 (Vue Dev)"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
